{
  "cli_default_open_behavior": "new_window",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "outline_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": { "dock": "left" },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "cursor_shape": "hollow",
  "theme": {
    "mode": "light",
    "light": "JetBrains Islands Light",
    "dark": "One Dark"
  },
  "base_keymap": "VSCode",
  // "base_keymap": "JetBrains",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "buffer_font_family": "iA Writer Mono S",
  // "buffer_font_family": "Iosevka",
  // "buffer_font_family": "PragmataPro Liga",
  // "buffer_font_family": ".ZedMono",
  "text_rendering_mode": "grayscale",
  "buffer_font_size": 12,
  "buffer_line_height": "comfortable",
  "ui_font_size": 12,
  "confirm_quit": false,
  "cursor_blink": false,
  "wrap_guides": [80, 120],
  "inlay_hints": { "enabled": true },
  "project_panel": {
    "dock": "left",
    "indent_size": 10
  },
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "languages": {
    "Markdown": {
      "indent_list_on_tab": true,
      "preferred_line_length": 120,
      "wrap_guides": [64, 72, 120],
    }
  }
}
