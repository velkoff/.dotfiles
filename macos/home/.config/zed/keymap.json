[
  // Expand behavior (incremental/decremental)
  {
    "context": "Editor",
    "bindings": {
      "alt-k": "editor::SelectLargerSyntaxNode",
      "alt-j": "editor::SelectSmallerSyntaxNode",
      "cmd-o": "outline::Toggle",
    },
  },

  // Move tabs
  {
    "context": "Pane",
    "bindings": {
      "cmd-alt-left": "pane::SwapItemLeft",
      "cmd-alt-right": "pane::SwapItemRight"
    }
  },

  // Search beahavior re: auto-close
  {
     "context": "BufferSearchBar",
     "bindings": {
       "enter": ["workspace::SendKeystrokes", "enter escape"]
     }
   },

  // Set font size (global)
  {
    "bindings": {
      "ctrl->": "zed::IncreaseBufferFontSize",
      "ctrl-<": "zed::DecreaseBufferFontSize",
      "ctrl-)": "zed::ResetBufferFontSize"
    }
  },

  // Split behavior
  {
    "bindings": {
      "alt-tab": "workspace::ActivateNextPane",
      "alt-enter": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-s l": "pane::SplitRight",
      "cmd-shift-s j": "pane::SplitDown",
      "alt-]": "workspace::ActivateNextPane",
      "alt-[": "workspace::ActivatePreviousPane",
    },
  },

  // Markdown preview
  {
    "context": "Editor && extension == md",
    "bindings": {
      "cmd-r": "markdown::OpenPreview",
      "cmd-k v": "markdown::OpenPreviewToTheSide",
    },
  },

  // Vim
  {
    // Emacs bindings in insert mode
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-b": "editor::MoveLeft",
      "ctrl-f": "editor::MoveRight",
      "alt-f": "editor::MoveToNextWordEnd",
      "alt-b": "editor::MoveToPreviousWordStart",
      "ctrl-a": [
        "editor::MoveToBeginningOfLine",
        {
          "stop_at_soft_wraps": false,
          "stop_at_indent": false
        }
      ],
      "ctrl-e": [
        "editor::MoveToEndOfLine",
        {
          "stop_at_soft_wraps": false
        }
      ],
      "alt-d": "editor::DeleteToNextWordEnd",
      "alt-w": "editor::DeleteToPreviousWordStart",
    }
  },
  {
    // Editor navigation
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "shift-j": ["workspace::SendKeystrokes", "}"],
      "shift-k": ["workspace::SendKeystrokes", "{"],
      "shift-h": ["workspace::SendKeystrokes", "_"],
      "shift-l": ["workspace::SendKeystrokes", "$"],
      "shift-m": ["workspace::SendKeystrokes", "%"],
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],

      "] e": "editor::GoToDiagnostic",
      "[ e": "editor::GoToPreviousDiagnostic",
      "space e": "editor::Hover",
      "space u": "editor::FindAllReferences",

      "space f": "file_finder::Toggle",
      "space g": "text_finder::Toggle",
      "space p": "command_palette::Toggle",
      "space space": "workspace::ToggleLeftDock",

      "alt--": "editor::Fold",
      "alt-=": "editor::UnfoldLines",
      "alt-l": "editor::JoinLines"
    }
  }
]
